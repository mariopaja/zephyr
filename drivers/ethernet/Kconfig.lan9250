# LAN9250 Stand-alone Ethernet Controller configuration options

# Copyright (c) 2024 Mario Paja
# SPDX-License-Identifier: Apache-2.0


menuconfig ETH_LAN9250
	bool "LAN9250 Ethernet Controller"
	default y
	depends on DT_HAS_MICROCHIP_LAN9250_ENABLED
	select GPIO
	select SPI if $(dt_compat_on_bus,$(DT_COMPAT_MICROCHIP_LAN9250),spi)
	select MSPI if $(dt_compat_on_bus,$(DT_COMPAT_MICROCHIP_LAN9250),mspi)
	help
	  LAN9250 Stand-Alone Ethernet Controller
	  with SPI Interface, connected to an SPI or MSPI controller

if ETH_LAN9250

config ETH_LAN9250_RX_THREAD_STACK_SIZE
	int "Stack size for internal incoming packet handler"
	default 1024
	help
	  Size of the stack used for internal thread which is ran for
	  incoming packet processing. The thread handles all device
	  interrupts, including PHY and MAC register accesses over SPI.
	  Increase it when NET_TC_RX_COUNT is 0, as received packets are
	  then processed by the network stack in this thread.

config ETH_LAN9250_RX_THREAD_PRIO
	int "Priority for internal incoming packet handler"
	default 2
	help
	  Priority level for internal thread which is ran for incoming
	  packet processing.

config ETH_LAN9250_SPI_FAST_READ
	bool "Use the SPI Fast Read instruction"
	default y
	help
	  Read registers and the RX data FIFO with the SPI Fast Read
	  instruction (0x0B), which supports SPI clock rates up to 80 MHz.
	  The Read instruction (0x03) is limited to 30 MHz. Fast Read adds
	  one dummy byte to each read transfer. Only used for devices on an
	  SPI controller, devices on an MSPI controller always use Fast Read
	  or the dual and quad read instructions.

config ETH_LAN9250_BUF_ALLOC_TIMEOUT
	int "Network buffer allocation timeout"
	default 100
	help
	  Given timeout in milliseconds. Maximum amount of time
	  that the driver will wait from the IP stack to get
	  a memory buffer before the Ethernet frame is dropped.

endif
